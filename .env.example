# ─── Mode ────────────────────────────────────────────────────────────────────
# Set to true to skip real provider API calls (uses mock data).
USE_MOCK=true

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
# Absolute path to SQLite file. Defaults to sentinel.db in project root.
DB_PATH=

# ─── Provider API Keys ───────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=

# ─── Alerting: Slack (required for real alerts) ───────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Alerting: Email (optional) ───────────────────────────────────────────────
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Integer between 1–24. Default: 6.
HEALTH_CHECK_INTERVAL_HOURS=6

# ─── Mozart Sync (optional extension) ────────────────────────────────────────
MOZART_API_URL=https://api-dev.mozart.la
MOZART_API_TOKEN=
